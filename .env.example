# Copy to .env and edit. The three secrets below have no usable default: the stack refuses to start until you set them
# (generate each with `openssl rand -hex 32`).
# Compose reads this file automatically.

# --- Security: change before exposing the instance ---
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-or-more-characters
POSTGRES_PASSWORD=change-me-database-password
S3_SECRET_KEY=change-me-storage-secret

# --- Public URLs (what the browser uses) ---
WEB_PORT=8080
API_PORT=3000
MCP_PORT=3001
WEB_ORIGIN=http://localhost:8080
API_PUBLIC_URL=http://localhost:3000
LIVE_PORT=3002
LIVE_PUBLIC_URL=ws://localhost:3002
# For the Caddy compose override, set this to the public root URL (for example https://weft.example) and set SITE_ADDRESS to weft.example.
# It serves the web app, API, MCP, OAuth metadata and assets from one origin. Leave it unset for the plain multi-port stack.
# Caddy obtains and renews HTTPS certificates automatically for public domains. Only root-domain hosting is supported; path prefixes are not.
# WEFT_PUBLIC_URL=https://weft.example
# SITE_ADDRESS=weft.example
# Number of trusted reverse proxies in front of the API (they append the caller to x-forwarded-for). Used to rate-limit anonymous OAuth client registration per caller.
# TRUSTED_PROXY_HOPS=1
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- Signup and workspace creation ---
# The first user can always register and create the first workspace.
ALLOW_SIGNUP=true
ALLOW_WORKSPACE_CREATION=true
# Minimum password length (default 10); breach checks use HIBP with an offline fallback (set off for closed networks).
MIN_PASSWORD_LENGTH=10
PASSWORD_BREACH_CHECK=on
# Sign-in, sign-up, reset and API limits (README, Environment reference). Defaults are safe; a lock always ends by itself.
# Counts live in API memory per process: a restart clears them, and each API instance counts on its own.
SIGN_IN_MAX_FAILURES=5
SIGN_IN_LOCK_MINUTES=15
SIGN_IN_ADDRESS_MAX_FAILURES=50
SIGN_UP_REQUESTS_PER_HOUR=20
PASSWORD_RESET_REQUESTS_PER_HOUR=10
API_REQUESTS_PER_MINUTE=600
# Optional company Microsoft Entra sign-in. Set all three values to enable a single-tenant provider.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Optional comma-separated email domains, for example company.example, subsidiary.example.
MICROSOFT_ALLOWED_EMAIL_DOMAINS=
# Set false only after Microsoft sign-in is verified; set true again to recover password access.
PASSWORD_SIGN_IN_ENABLED=true
# Optional instance-wide interface language for people without a saved choice: en or th.
DEFAULT_LANGUAGE=
# GitHub and GitLab pull request links (docs/integrations/github-gitlab.md). Off unless set to exactly true.
WEFT_INTEGRATIONS_ENABLED=false

# --- Email (optional) ---
# Email is on only when SMTP_HOST and SMTP_FROM are both set. Without them the product works as before: no verification or
# reset emails, no notification emails, and the sign-in and account pages say email is not set up.
# SMTP_SECURE=true uses TLS from the start (usually port 465); false uses STARTTLS when the server offers it (usually port 587).
# SMTP_PORT defaults to 465 with SMTP_SECURE=true, otherwise 587.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Minutes between notification email digests (one email per person per run, batched).
EMAIL_DIGEST_MINUTES=5

# --- AI provider and model ---
AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Storage and limits ---
S3_ACCESS_KEY=weft
S3_BUCKET=weft-assets
S3_REGION=us-east-1
ASSET_MAX_BYTES=5242880

# --- Host ports for the bundled services ---
POSTGRES_PORT=54329
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Per-user AI requests per minute (429 rate_limited when exceeded)
AI_REQUESTS_PER_MINUTE=20
# Set to off to remove the Web search switch from the AI chat for everyone.
AI_WEB_SEARCH=on
