# Copy to .env and edit. The three secrets below have no usable default: the stack refuses to start until you set them
# (generate each with `openssl rand -hex 32`).
# Compose reads this file automatically.

# --- Security: change before exposing the instance ---
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-or-more-characters
POSTGRES_PASSWORD=change-me-database-password
S3_SECRET_KEY=change-me-storage-secret

# --- Public URLs (what the browser uses) ---
WEB_PORT=8080
API_PORT=3000
MCP_PORT=3001
WEB_ORIGIN=http://localhost:8080
API_PUBLIC_URL=http://localhost:3000
LIVE_PORT=3002
LIVE_PUBLIC_URL=ws://localhost:3002
# Only for HTTP MCP and OAuth behind one reverse proxy: the single public origin serving /mcp, /api, /.well-known and the web app.
# Leave it unset for the plain local stack (sign-in then stays on API_PUBLIC_URL).
# WEFT_PUBLIC_URL=https://weft.example
# Number of trusted reverse proxies in front of the API (they append the caller to x-forwarded-for). Used to rate-limit anonymous OAuth client registration per caller.
# TRUSTED_PROXY_HOPS=1
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- Signup and workspace creation ---
# The first user can always register and create the first workspace.
ALLOW_SIGNUP=true
ALLOW_WORKSPACE_CREATION=true

# --- AI provider and model ---
AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Storage and limits ---
S3_ACCESS_KEY=weft
S3_BUCKET=weft-assets
S3_REGION=us-east-1
ASSET_MAX_BYTES=5242880

# --- Host ports for the bundled services ---
POSTGRES_PORT=54329
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Per-user AI requests per minute (429 rate_limited when exceeded)
AI_REQUESTS_PER_MINUTE=20
