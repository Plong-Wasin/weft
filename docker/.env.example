POSTGRES_DB=weft
POSTGRES_USER=weft
POSTGRES_PASSWORD=
WEFT_LISTEN=0.0.0.0:8080
WEFT_COOKIE_SECURE=0
# Comma-separated repository hostnames allowed for URL-based Vault imports; empty disables them.
WEFT_VAULT_IMPORT_HOSTS=
# Rows one CSV export may hold, 1 to 100000 (default 10000); other values fall back to the default.
WEFT_EXPORT_ROW_CEILING=
# Rows read per page while a CSV export runs, 1 to 1000 (default 200); other values fall back to the default.
WEFT_EXPORT_BATCH=
